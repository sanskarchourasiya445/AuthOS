# =============================================================================
# AuthOS Environment Configuration Reference (.env.example)
#
# Instructions:
# 1. Copy this template to .env: `cp .env.example .env`
# 2. Never commit .env to version control (.gitignore enforces this).
# 3. For development, default placeholder values work out-of-the-box.
# 4. In production (APP_ENV=production), strict validation requires:
#    - AUTH_SECRET_KEY must be a distinct, random secret (>= 32 bytes)
#    - DATABASE_URL must point to a secure, non-default PostgreSQL instance
#    - GEMINI_API_KEY is required if LLM_PROVIDER=gemini
# =============================================================================

# --- Application Environment ---
# Allowed values: development, staging, production
APP_ENV=development

# --- API Prefix ---
API_PREFIX=/api/v1

# --- PostgreSQL Database Connection ---
# Local Docker Compose default: postgresql+psycopg2://authos:authos@localhost:5432/authos
# Local Windows native dev default: postgresql+psycopg2://authos@localhost:5433/authos
DATABASE_URL=postgresql+psycopg2://authos:authos@localhost:5432/authos

# --- Retrieval Configuration ---
ENABLE_CORRECTIVE_RETRIEVAL=false
MAX_RETRIEVAL_RETRIES=2

# --- Authentication & JWT Security ---
# WARNING: In production, generate a secure random 32-byte secret (e.g. `openssl rand -hex 32`)
AUTH_SECRET_KEY=dev-insecure-secret-key-change-in-production-authos-2026
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=120
AUTH_ISSUER=authos
AUTH_AUDIENCE=authos-api

# --- Advisory LLM Provider (Optional / Advisory Only) ---
# The authoritative verifier remains deterministic and does NOT require an external LLM.
# Options: 'stub' (offline deterministic stub, default) or 'gemini' (hosted Google Gemini)
LLM_PROVIDER=stub
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
