# Copy to .env locally. Never put real credentials in this file or commit .env.
APP_ENV=development
DATABASE_URL=postgresql://authos:authos@localhost:5432/authos
LLM_PROVIDER=claude
LLM_MODEL=SET_BEFORE_IMPLEMENTATION
LLM_API_KEY=replace_me
EMBEDDING_PROVIDER=SET_BEFORE_IMPLEMENTATION
EMBEDDING_MODEL=SET_BEFORE_IMPLEMENTATION
EMBEDDING_DIMENSION=SET_BEFORE_IMPLEMENTATION
MAX_RETRIEVAL_RETRIES=2
AUTH_SECRET_KEY=replace_with_32_byte_random_secret_in_production
AUTH_TOKEN_EXPIRE_MINUTES=120
